# PostgreSQL
DATABASE_URL=
POSTGRES_DB=gistai
POSTGRES_USER=gistai
POSTGRES_PASSWORD=gistai

# LLM（请在本地 .env 中填写真实配置）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding（请在本地 .env 中填写真实配置）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# RAG
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.35
