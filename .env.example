# PostgreSQL（业务数据与 LangGraph checkpoint 共用实例、使用独立表）
DATABASE_URL=postgresql+psycopg://gistai:gistai@localhost:5432/gistai
POSTGRES_DB=gistai
POSTGRES_USER=gistai
POSTGRES_PASSWORD=gistai

# 普通 HTTP 网页抓取
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_REDIRECTS=5
FETCH_MIN_CONTENT_CHARS=200
FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) GistAI/1.0
PLAYWRIGHT_NAVIGATION_TIMEOUT_SECONDS=30
PLAYWRIGHT_NETWORK_IDLE_TIMEOUT_SECONDS=5

# LLM（请在本地 .env 中填写真实配置）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Web Search（默认 Tavily，请在本地 .env 中填写真实配置）
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
AGENT_MAX_FULLTEXT_CONTEXT_TOKENS=8000

# Embedding（请在本地 .env 中填写真实配置）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=10

# RAG
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=12000
